# 1 = in-memory demo backend (any phone, OTP 123456). Demo mode is also used automatically when the
# Supabase variables below are empty. Set to 0 to use Supabase.
EXPO_PUBLIC_DEMO_MODE=1

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Testing only: pretend the phone is in Vijayawada, where the seed data lives (never for store builds)
# EXPO_PUBLIC_FORCE_TEST_LOCATION=1

# CI-only live-Supabase demo seed. The city is deliberately non-production; never enable in store builds.
# EXPO_PUBLIC_DEMO_CITY=Vijayawada Demo
# EXPO_PUBLIC_DEMO_PAYMENT=1
